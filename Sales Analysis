-- Total Store per store

SELECT 
	st.store_name,
    cus.state,
    ROUND(SUM(oi.quantity * oi.list_price),2) as TotalSales
FROM
	stores as st
INNER JOIN
	orders as ord
ON
	st.store_id = ord.store_id
INNER JOIN
	 order_items as oi
ON
	ord.order_id = oi.order_id
INNER JOIN
	customers as cus
ON
	ord.customer_id = cus.customer_id
WHERE
	ord.order_status ='4'
GROUP BY
	st.store_name,
    cus.state
 ORDER BY
	SUM(oi.quantity * oi.list_price) desc;    
    
