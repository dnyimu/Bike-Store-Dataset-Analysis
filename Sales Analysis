-- TOP 3 Category Sales(Sales Revenue) in across all stores combined
SELECT
	cat.category_name,
   ROUND( SUM(oi.quantity * oi.list_price),2) AS SalesRevenue
FROM
	stores as st
INNER JOIN
	orders  as o
ON
	st.store_id= o.store_id
INNER JOIN
	order_items as oi
ON
	oi.order_id = o.order_id
INNER JOIN
	products as p
ON 
	p.product_id = oi.product_id
INNER JOIN
	categories  as cat
ON 
 p.category_id  = cat. category_id
 WHERE
	o.order_status ='4'
 GROUP BY
	cat.category_name
 ORDER BY
	SUM(oi.quantity * oi.list_price) desc
LIMIT
3;
